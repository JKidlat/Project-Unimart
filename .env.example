# ==============================================================================
# UNIMART FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE (Vite)
# ==============================================================================
# Copy this file to .env.local for local development.
# Only VITE_ prefixed variables are exposed to the client-side JavaScript bundle.
# NEVER put private API secrets, database passwords, or Supabase service keys here!
# ==============================================================================

# Backend REST API Base URL
VITE_API_URL=http://localhost:8000/api

# Paystack Public Key (Safe for client-side checkout popup)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_paystack_public_key

# Firebase Web Client (Optional public credentials)
VITE_FIREBASE_API_KEY=your-firebase-public-api-key
VITE_FIREBASE_AUTH_DOMAIN=unimart-c4308.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=unimart-c4308
VITE_FIREBASE_STORAGE_BUCKET=unimart-c4308.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=911425195338
VITE_FIREBASE_APP_ID=1:911425195338:web:your-app-id


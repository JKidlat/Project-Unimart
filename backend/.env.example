# ==============================================================================
# UNIMART BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and provide your actual secrets.
# NEVER commit real credentials to version control.
# ==============================================================================

# Django Core
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,api.unimart.gh,your-deployment-domain.com

# Database (Supabase PostgreSQL / External PostgreSQL)
# Example: postgresql://postgres.[ref]:[password]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# CORS & CSRF Configuration (Vercel Frontend & Local Development)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://unimart-frontend.vercel.app
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000,https://unimart-frontend.vercel.app

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=sk_live_replace_with_actual_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_replace_with_actual_paystack_public_key

# JWT Token Lifetimes (Optional Overrides)
JWT_ACCESS_TOKEN_LIFETIME_HOURS=72
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Firebase Service Account (Optional for social auth / Firebase ID token validation)
# Place your service account certificate in backend/firebase-credentials.json
FIREBASE_PROJECT_ID=unimart-c4308

# Frontend URL & Resend Email Delivery (for email verification & password resets)
FRONTEND_URL=https://project-unimart.vercel.app
RESEND_API_KEY=re_replace_with_your_resend_api_key
DEFAULT_FROM_EMAIL=Unimart <onboarding@resend.dev>

